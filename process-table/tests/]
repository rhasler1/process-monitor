use process_table::{Lexer, Parser, ProcessEntry as Row, ProcessTable, ProcessTableViewState};

fn test_rows() -> Vec<Row> {
    vec![
        Row::new(1, 1.0, 1, "a".to_string()),
        Row::new(2, 2.0, 2, "b".to_string()),
        Row::new(3, 3.0, 3, "c".to_string()),
        Row::new(4, 4.0, 4, "d".to_string()),
    ]
}

#[test]
fn test_table_and_view() {
    let rows = test_rows();

    let table = ProcessTable::new(rows);

    let mut view_state = ProcessTableViewState::default();

    let visual_row_count = table.rows().count();
    view_state.update_row_selection(visual_row_count);
    assert_eq!(view_state.visual_row_selection(), Some(0));

    // BVA: Cannot inc past visual row count
    for _ in 0..visual_row_count + 1 {
        view_state.inc_visual_row_selection(visual_row_count);
    }

    // Mock filter
    let filter_string = "pid = 1 | pid = 2 & cpu < 2".to_string();

    // Note: Consumer should check for error, not unwrap
    // On Err consumer can set a status message
    view_state.update_row_filter(&filter_string).unwrap();

    if let Some(ast) = view_state.filter_ast() {
        let mut filtered_rows = table.rows_filtered(ast);

        assert_eq!(
            filtered_rows.next(),
            Some(&Row::new(1, 1.0, 1, "a".to_string())),
        );
        assert!(filtered_rows.next().is_none())
    }
}
